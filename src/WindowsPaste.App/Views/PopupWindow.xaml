<Window x:Class="WindowsPaste.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WindowsPaste.Converters"
        Title="Windows Paste"
        Height="330"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <conv:TypeToGlyphConverter x:Key="TypeGlyph" />
        <conv:TypeToThumbnailConverter x:Key="TypeThumbnail" />
        <conv:TypeIsImageConverter x:Key="TypeIsImage" />
        <conv:ClipboardItemToBrushConverter x:Key="ItemBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ClipboardItemToGlyphBrushConverter x:Key="GlyphBrush" />

        <!-- One history card. Square, so the shelf reads as a row of tiles. -->
        <DataTemplate x:Key="CardTemplate">
            <Border x:Name="Card"
                    Width="172"
                    Height="172"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#1F000000"
                    Background="{Binding Converter={StaticResource ItemBrush}}">
                <Grid Margin="12,10,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: type glyph + type label -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Converter={StaticResource TypeGlyph}}"
                                       FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="14"
                                       Foreground="{Binding Converter={StaticResource GlyphBrush}}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TypeLabel}"
                                       Margin="6,0,0,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Converter={StaticResource GlyphBrush}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="0"
                                   Text="PIN"
                                   HorizontalAlignment="Right"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB8860B"
                                   Visibility="{Binding Pinned, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <!-- Body: image thumbnail, or text preview -->
                    <Grid Grid.Row="1" Margin="0,8,0,8">
                        <TextBlock x:Name="TextBody"
                                   Text="{Binding Preview}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="12.5"
                                   LineHeight="18"
                                   Foreground="#FF1A1A1E"
                                   VerticalAlignment="Top" />

                        <Border x:Name="ImageBody"
                                CornerRadius="6"
                                Background="#14000000"
                                Visibility="{Binding Type, Converter={StaticResource TypeIsImage}}">
                            <Image Source="{Binding Converter={StaticResource TypeThumbnail}}"
                                   Stretch="Uniform"
                                   Margin="4" />
                        </Border>
                    </Grid>

                    <!-- Footer: timestamp -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding CreatedAtLabel}"
                               FontSize="10"
                               Foreground="#FF6B6B72" />
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            Card container. The halo ring lives inside a fixed-size host so the
            hit box is identical for default, hover and selected states; only the
            brush changes. This keeps cards from shifting as the pointer moves.
        -->
        <Style x:Key="CardContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- Fixed ring thickness: the ring always occupies its space -->
                        <Border x:Name="Halo"
                                CornerRadius="16"
                                BorderThickness="3"
                                BorderBrush="Transparent"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="BorderBrush" Value="#22000000" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Halo" Property="BorderBrush" Value="#FF3A78FF" />
                                <Setter TargetName="Halo" Property="Background" Value="#143A78FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Light frosted panel that slides up from the bottom edge. -->
    <Border CornerRadius="18"
            BorderThickness="1"
            BorderBrush="#2E000000"
            Background="#F2FBFBFD"
            Margin="0"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="-2" Opacity="0.16" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10,14,10,4">
                <!-- Horizontal card strip -->
                <ListBox x:Name="ItemsList"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemTemplate="{StaticResource CardTemplate}"
                         ItemContainerStyle="{StaticResource CardContainerStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnItemActivated">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <TextBlock Text="No clipboard history yet"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#FF8A8A92"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Search field centred along the bottom of the panel, so the
                 search bar and the card strip read as one unit. -->
            <Border Grid.Row="1"
                    Width="360"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="#22000000"
                    Background="#14000000">
                <Grid>
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                               FontSize="14"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="#FF8A8A92" />
                    <TextBox x:Name="SearchBox"
                             Padding="38,8,12,8"
                             FontSize="13.5"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="#FF1A1A1E"
                             CaretBrush="#FF1A1A1E"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="Search clipboard history"
                               Margin="40,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontSize="13.5"
                               Foreground="#FF9A9AA2" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
