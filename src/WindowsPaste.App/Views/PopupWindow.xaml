<Window x:Class="WindowsPaste.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WindowsPaste.Converters"
        Title="Windows Paste"
        Height="600"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <conv:TypeToGlyphConverter x:Key="TypeGlyph" />
        <conv:TypeToThumbnailConverter x:Key="TypeThumbnail" />
        <conv:TypeIsImageConverter x:Key="TypeIsImage" />
        <conv:ClipboardItemToBrushConverter x:Key="ItemBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ClipboardItemToGlyphBrushConverter x:Key="GlyphBrush" />
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />

        <!--
            Pin toggle on a card. Hidden until the card is hovered, and always
            visible once pinned, so the badge does not clutter the idle grid.
            Tag carries the item's Pinned flag. Declared before CardTemplate so
            the card's DataTemplate can resolve it.
        -->
        <Style x:Key="PinButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FF8A8A92" />
            <Setter Property="Content" Value="&#xE718;" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="11" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Hidden until the card is hovered; pinned cards keep it visible. -->
            <Setter Property="Opacity">
                <Setter.Value>
                    <Binding Path="IsMouseOver"
                             RelativeSource="{RelativeSource AncestorType=ListBoxItem}"
                             Converter="{StaticResource BoolToOpacity}" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Pinned: always visible, filled glyph, amber tint -->
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Foreground" Value="#FFB8860B" />
                    <Setter Property="Content" Value="&#xE840;" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            One history card. The card fills its grid cell, and its height is
            bound to its own width so it stays square however wide the cell is.
        -->
        <DataTemplate x:Key="CardTemplate">
            <Border x:Name="Card"
                    MinWidth="110" MinHeight="110"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#1F000000"
                    Background="{Binding Converter={StaticResource ItemBrush}}"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">
                <Grid Margin="12,10,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: type glyph + type label, plus the pin toggle -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Converter={StaticResource TypeGlyph}}"
                                       FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="14"
                                       Foreground="{Binding Converter={StaticResource GlyphBrush}}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TypeLabel}"
                                       Margin="6,0,0,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Converter={StaticResource GlyphBrush}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Pin toggle: shown while pinned, or on card hover -->
                        <Button x:Name="PinButton"
                                Style="{StaticResource PinButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Tag="{Binding Pinned}"
                                ToolTip="Pin (Ctrl+P)"
                                Click="OnPinButtonClick" />                    </Grid>

                    <!-- Body: image thumbnail, or text preview -->
                    <Grid Grid.Row="1" Margin="0,8,0,8">
                        <TextBlock x:Name="TextBody"
                                   Text="{Binding Preview}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="12.5"
                                   LineHeight="18"
                                   Foreground="#FF1A1A1E"
                                   VerticalAlignment="Top" />

                        <Border x:Name="ImageBody"
                                CornerRadius="6"
                                Background="#14000000"
                                Visibility="{Binding Type, Converter={StaticResource TypeIsImage}}">
                            <Image Source="{Binding Converter={StaticResource TypeThumbnail}}"
                                   Stretch="Uniform"
                                   Margin="4" />
                        </Border>
                    </Grid>

                    <!-- Footer: timestamp -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding CreatedAtLabel}"
                               FontSize="10"
                               Foreground="#FF6B6B72" />
                </Grid>
            </Border>
        </DataTemplate>

        <!--
            Card container. The halo ring lives inside a fixed-size host so the
            hit box is identical for default, hover and selected states; only the
            brush changes. This keeps cards from shifting as the pointer moves.
        -->
        <Style x:Key="CardContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- Fixed ring thickness: the ring always occupies its space -->
                        <Border x:Name="Halo"
                                CornerRadius="16"
                                BorderThickness="3"
                                BorderBrush="Transparent"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Paste" Click="OnContextPaste" />
                                    <MenuItem Header="Pin / Unpin" Click="OnContextPin" />
                                    <Separator />
                                    <MenuItem Header="Remove" Click="OnContextRemove" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="BorderBrush" Value="#22000000" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Halo" Property="BorderBrush" Value="#FF3A78FF" />
                                <Setter TargetName="Halo" Property="Background" Value="#143A78FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat circular tool button used for the previous/next navigation. -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="#FF2A2A32" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="18"
                                Background="#14000000"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#38000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Light frosted panel, centred on screen. -->
    <Border CornerRadius="18"
            BorderThickness="1"
            BorderBrush="#2E000000"
            Background="#F2FBFBFD">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.2" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Card list -->
                <RowDefinition Height="*" />
                <!-- Toolbar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Card grid, laid out from the top of the upper region -->
            <Grid Grid.Row="0" Margin="10,16,10,6">
                <ListBox x:Name="ItemsList"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemTemplate="{StaticResource CardTemplate}"
                         ItemContainerStyle="{StaticResource CardContainerStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Top"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         MouseDoubleClick="OnItemActivated">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Columns is set from code to match the available
                                 width, so every row fills edge to edge. -->
                            <UniformGrid x:Name="CardGrid" Columns="6" VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <TextBlock Text="No clipboard history yet"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#FF8A8A92"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Toolbar: search on the left, navigation on the right -->
            <Border Grid.Row="1"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#14000000"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search field -->
                    <Border Grid.Column="0"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="#22000000"
                            Background="#14000000">
                        <Grid>
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="14"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="#FF8A8A92" />
                            <TextBox x:Name="SearchBox"
                                     Padding="38,9,12,9"
                                     FontSize="13.5"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#FF1A1A1E"
                                     CaretBrush="#FF1A1A1E"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Search clipboard history"
                                       Margin="40,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontSize="13.5"
                                       Foreground="#FF9A9AA2" />
                        </Grid>
                    </Border>

                    <!-- Previous / next navigation -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <Button x:Name="PrevButton"
                                Style="{StaticResource NavButtonStyle}"
                                Content="&#xE76B;"
                                ToolTip="Previous"
                                IsEnabled="{Binding CanSelectPrevious}"
                                Click="OnPreviousClick" />
                        <Button x:Name="NextButton"
                                Style="{StaticResource NavButtonStyle}"
                                Content="&#xE76C;"
                                Margin="8,0,0,0"
                                ToolTip="Next"
                                IsEnabled="{Binding CanSelectNext}"
                                Click="OnNextClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
