<Window x:Class="WindowsPaste.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Paste - Settings"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E22"
        Foreground="#FFF0F0F0"
        FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

        <TextBlock Text="Global hotkey" Margin="0,0,0,6" Foreground="#AAFFFFFF" />
        <TextBox x:Name="HotkeyBox"
                 Padding="8,6"
                 IsReadOnly="True"
                 Background="#22FFFFFF"
                 Foreground="#FFF0F0F0"
                 BorderBrush="#33FFFFFF"
                 PreviewKeyDown="OnHotkeyBoxKeyDown"
                 GotKeyboardFocus="OnHotkeyBoxFocus"
                 LostKeyboardFocus="OnHotkeyBoxBlur"
                 Text="Click and press a key combination" />

        <TextBlock Text="History capacity (unpinned items)" Margin="0,16,0,6" Foreground="#AAFFFFFF" />
        <Slider x:Name="CapacitySlider" Minimum="50" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" />

        <CheckBox x:Name="StartupCheck" Content="Start with Windows" Margin="0,16,0,0" Foreground="#FFF0F0F0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Padding="16,6" Margin="0,0,8,0" Click="OnCancel" />
            <Button x:Name="SaveButton" Content="Save" Padding="16,6" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
