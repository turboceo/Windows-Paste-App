{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows Paste",
  "version": "0.2.0",
  "identifier": "com.pyzl.windowspaste",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Windows Paste",
        "width": 1080,
        "height": 600,
        "minWidth": 720,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALAPPDATA/WindowsPaste/blobs/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "resources": ["tray-icon.png"],
    "publisher": "Pyzl",
    "shortDescription": "Paste.app 风格的 Windows 剪贴板历史管理器",
    "longDescription": "Windows Paste 是一款深度还原 macOS Paste 体验的高性能 Windows 剪贴板历史管理器。按 Ctrl+Shift+V 随时呼出面板，支持格式智能识别、分类 Tag、键盘矩阵导航与一键原生粘贴。",
    "copyright": "Copyright © 2026 Pyzl",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["zh-CN", "en-US"]
      }
    }
  }
}
