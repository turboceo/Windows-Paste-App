{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows Paste",
  "version": "0.2.0",
  "identifier": "com.pyzl.windowspaste",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Windows Paste",
        "width": 1080,
        "height": 600,
        "minWidth": 720,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALAPPDATA/WindowsPaste/blobs/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
