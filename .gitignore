# ==========================================
# Windows Paste App - Git Ignore Rules
# ==========================================

# ------------------------------------------
# 0. Rust & Tauri
# ------------------------------------------
target/
src-tauri/target/
Cargo.lock
src-tauri/Cargo.lock
**/*.rs.bk

# ------------------------------------------
# 1. Node.js / Vite / React Frontend
# ------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment variables
.env.local
.env.*.local

# ------------------------------------------
# 3. Local Databases & Diagnostics
# ------------------------------------------
# SQLite runtime files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Test & diagnostic dump outputs
webhost.txt
selftest.txt
seed.txt
*.log

# ------------------------------------------
# 4. Editors & Operating System
# ------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code / Cursor workspace settings
# (Ignore local workspace states, allow shared configs if added in the future)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.cursor/
*.code-workspace
